# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Demo User ID for Dashboard Demo Mode
NEXT_PUBLIC_DEMO_USER_ID=

# Gemini API Key for receipt scanning (server-only, never NEXT_PUBLIC)
GEMINI_API_KEY=

# HMAC key for signed public trust cards (use a unique random value in production)
SPLITSCORE_SIGNING_SECRET=

# Optional demo sign-in credentials (seed the matching user in Supabase first)
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Optional local-only receipt parser mock; do not enable in production
MOCK_RECEIPT=false
